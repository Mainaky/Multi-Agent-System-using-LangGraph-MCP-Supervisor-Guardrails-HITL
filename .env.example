# Set true to run the no-credentials interactive sample experience.
DEMO_MODE=false

# Required only for live AI planning. Check your provider's current free limits and pricing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: PostgreSQL enables durable LangGraph checkpoints. Without it, the live
# graph uses in-memory checkpoints that disappear when the service restarts.
# Example: postgresql://tripmate:password@localhost:5432/tripmate
DATABASE_URL=

# Required for live hotel and web search through Tavily MCP.
TAVILY_API_KEY=

# Required for the AviationStack MCP flight data adapter.
AVIATION_STACK_API_KEY=

# Required for the custom OpenWeather MCP server.
OPENWEATHER_API_KEY=

# Optional Google OAuth sign-in. Google Console redirect URI must be:
# http://127.0.0.1:8000/auth/google/callback
APP_BASE_URL=http://127.0.0.1:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Use a long, random secret; set SESSION_COOKIE_SECURE=true on HTTPS deployments.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
