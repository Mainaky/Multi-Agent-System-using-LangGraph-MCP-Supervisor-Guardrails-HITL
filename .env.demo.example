# Credential-free interactive demo. Uses illustrative, deterministic sample data.
DEMO_MODE=true

# Optional: enables the interactive Google Maps route explorer in demo mode.
GOOGLE_MAPS_API_KEY=

# Optional Google OAuth login. Use a random SESSION_SECRET before enabling it.
APP_BASE_URL=http://127.0.0.1:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
